# Copy to .env (gitignored) and fill in: the app reads .env from its working directory on startup.
# Environment variables with the same names override it.
DB_URL=jdbc:postgresql://localhost:5433/youtube
DB_USERNAME=postgres
DB_PASSWORD=
KAFKA_BOOTSTRAP_SERVERS=localhost:9095
S3_ENDPOINT=http://localhost:9010
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Where players fetch streams/...: the CDN domain in production.
PLAYBACK_BASE_URL=http://localhost:8093
# ffmpeg (real HLS renditions) or simulated (no ffmpeg needed, nothing to play).
TRANSCODING_ENGINE=ffmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
REDIS_HOST=localhost
REDIS_PORT=6381
SEARCH_URL=http://localhost:9201
